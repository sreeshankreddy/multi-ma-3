# Environment Configuration Template
# Copy this file to .env and update with your values

# Database Settings
DATABASE_PATH=analyzer.db
DATABASE_BACKUP_DIR=./backups

# File Upload Settings
MAX_FILE_SIZE_MB=200
UPLOADS_DIR=./uploads
REPORTS_DIR=./reports
ALLOWED_FORMATS=pdf,jpg,jpeg,png,docx,txt

# OCR Settings
USE_EASYOCR=true
OCR_LANGUAGES=en,es,fr
TESSERACT_CMD=tesseract

# Model Settings
MODEL_DEVICE=cpu
USE_GPU=false
ENABLE_QUANTIZATION=false

# Summarization Settings
SUMMARY_MAX_LENGTH=150
SUMMARY_MIN_LENGTH=50
NUM_KEYWORDS=15
NUM_TOPICS=5

# Question Answering Settings
QA_CONFIDENCE_THRESHOLD=0.3
QA_MAX_ANSWER_LENGTH=256

# Logging Settings
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5

# Streamlit Settings
STREAMLIT_PORT=8501
STREAMLIT_THEME=light
STREAMLIT_SERVER_HEADLESS=false

# Security Settings
SESSION_TIMEOUT_MINUTES=30
MAX_FAILED_ATTEMPTS=5
HASH_ALGORITHM=sha256

# Feature Flags
ENABLE_CHAT=true
ENABLE_REPORTS=true
ENABLE_API=false
ENABLE_BATCH_PROCESSING=false
ENABLE_DARK_MODE=true

# API Settings (if enabled)
API_PORT=8000
API_HOST=0.0.0.0
API_DEBUG=false
API_CORS_ORIGINS=["*"]

# Email Settings (for notifications, if implemented)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password

# Application Settings
APP_NAME=Multimodal Document Analyzer
APP_VERSION=1.0.0
APP_AUTHOR=Your Name
SUPPORT_EMAIL=support@example.com
